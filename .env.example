POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales
POSTGRES_USER=sales
POSTGRES_PASSWORD=sales
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
SPARK_MASTER=local[*]
# Comma-separated local JDBC driver jars. When empty, Spark resolves SPARK_PACKAGES from Maven.
SPARK_JARS=
SPARK_PACKAGES=org.postgresql:postgresql:42.7.14,com.clickhouse:clickhouse-jdbc:0.9.8
